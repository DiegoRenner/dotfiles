# Set unified colors from chezmoi palette
set -g fish_color_command {{ .colors.accent | trimPrefix "#" }}
set -g fish_color_param {{ .colors.yellow | trimPrefix "#" }}
set -g fish_color_error {{ .colors.red | trimPrefix "#" }}
set -g fish_color_redirection {{ .colors.blue | trimPrefix "#" }}
set -g fish_color_user {{ .colors.magenta | trimPrefix "#" }}
set -g fish_color_host {{ .colors.orange | trimPrefix "#" }}
set -g fish_color_cwd {{ .colors.green | trimPrefix "#" }}

# set env vars
set -gx PATH "$PATH:$HOME/.scripts"
set -gx PATH "$PATH:/opt/depot_tools"
set -gx PATH "$PATH:$HOME/.gem/ruby/2.7.0/bin"
set -gx PATH "$PATH:$HOME/.cargo/bin/bender"
set -gx PATH "$PATH:$HOME/.local/bin"
# add cuda to path
set -gx CUDA_PATH /opt/cuda
set -gx PATH "$PATH:/opt/cuda/bin"
set -gx PATH "$PATH:/opt/cuda/nsight_compute"
set -gx PATH "$PATH:/opt/cuda/nsight_systems/bin"
set -gx NVCC_CCBIN "/usr/bin/g++-14"

{{ if eq .chezmoi.username "plantime" -}}
# Gas City service account on mustang: gc lives in ~/.local/gc-bin, the town
# ledger runs ahead of the packaged bd, and `systemd --user` over ssh (linger is
# enabled) only works with the runtime dir and bus address set explicitly.
fish_add_path -p ~/.local/gc-bin ~/.local/bin
set -gx BD_IGNORE_SCHEMA_SKEW 1
set -gx XDG_RUNTIME_DIR /run/user/(id -u)
set -gx DBUS_SESSION_BUS_ADDRESS unix:path=/run/user/(id -u)/bus
{{ end }}
set -gx EDITOR nvim
set -gx TERMINAL st
set -gx BROWSER brave
set -gx READER zathura
set -gx FILE ranger
set -gx PAGER less
set -gx SSH_AUTH_SOCK "$XDG_RUNTIME_DIR/ssh-agent.socket"

set -gx NOTMUCH_CONFIG "$HOME/.config/notmuch-config"
set -gx GTK2_RC_FILES "$HOME/.config/gtk-2.0/gtkrc-2.0"
set -gx LESSHISTFILE -
set -gx ZDOTDIR "$HOME/.config/zsh"

set -gx QSYS_ROOTDIR "$HOME/.cache/yay/quartus-free/pkg/quartus-free-quartus/opt/intelFPGA/23.1/quartus/sopc_builder/bin"

fish_vi_key_bindings
alias mv="mv -iv"
alias rm="rm -v"
alias mkd="mkdir -pv"
alias ffmpeg="ffmpeg -hide_banner" # Colorize commands when possible.
alias ls="ls -hN --color=auto --group-directories-first"
alias grep="grep --color=auto"
alias diff="diff --color=auto"

