# fzf recent dirs
zoxide init fish | source



# Gemini/Copilot Monitor Functions
function mo
    bash -c "~/.scripts/monitor_gemini.sh &"
end

function mq
    pkill -f monitor_gemini.sh
end

function ms
    ps aux | grep monitor_gemini.sh | grep -v grep
end
