#!/bin/bash
# gfx - switch GPU mode AND the matching boot entry in one step.
#
# WHY THIS EXISTS
# The panel backlight owner is decided ONCE PER BOOT by the kernel's backlight
# arbiter (__acpi_video_get_backlight_type, drivers/acpi/video_detect.c) from the
# kernel cmdline. It is latched for the whole boot -- there is no runtime knob, and
# no amount of modprobe/reload can change it. On this laptop (ASUS TUF FA608WV)
# the interface that physically drives the panel depends on the GPU mode:
#
#   AsusMuxDgpu  panel wired to NVIDIA -> nvidia_0                 [verified]
#                needs  acpi_backlight=native       -> g14.conf
#   Hybrid       panel wired to amdgpu -> nvidia_wmi_ec_backlight  [verified]
#                needs  NO acpi_backlight param     -> g14-hybrid.conf
#   Integrated   panel wired to amdgpu -> nvidia_wmi_ec_backlight  [verified]
#                needs  NO acpi_backlight param     -> g14-hybrid.conf (same)
#
# Verified dead ends: amdgpu_bl1 registers but does nothing in Hybrid AND
# Integrated; the EC device registers but does nothing in AsusMuxDgpu (the MUX
# switches its PWM lines away from the panel); acpi_backlight=native in an iGPU
# mode selects the dead amdgpu_bl1 and locks the working EC interface out.
#
# Because Hybrid and Integrated share a cmdline, switching between those two
# needs no reboot for brightness. Only switching to/from AsusMuxDgpu does.

set -u

DGPU_ENTRY="g14.conf"
IGPU_ENTRY="g14-hybrid.conf"

usage() {
    cat >&2 <<EOF
usage: gfx {dgpu|hybrid|integrated|status}

  dgpu        AsusMuxDgpu + boot entry '$DGPU_ENTRY'  (acpi_backlight=native -> nvidia_0)
  hybrid      Hybrid      + boot entry '$IGPU_ENTRY'  (no param -> nvidia_wmi_ec_backlight)
  integrated  Integrated  + boot entry '$IGPU_ENTRY'  (same cmdline as hybrid)
  status      current mode, boot default, live backlight device, and any mismatch

Switching to/from dgpu changes the cmdline, so it needs a reboot for brightness.
hybrid <-> integrated share a cmdline and do not.
EOF
    exit 2
}

# The cmdline each mode requires.
want_param_for() {
    case "$1" in
        AsusMuxDgpu) echo 'acpi_backlight=native' ;;
        *)           echo '(none)' ;;
    esac
}

running_param() {
    grep -o 'acpi_backlight=[a-z_]*' /proc/cmdline || echo '(none)'
}

boot_default() {
    bootctl status 2>/dev/null | awk -F': *' '/Default Entry/{print $2; exit}'
}

# Set the default in BOTH places so they can never disagree: the EFI variable
# (bootctl set-default) and loader.conf. The EFI variable alone is not durable --
# pressing 'd' on an entry in the systemd-boot menu rewrites it.
set_boot_default() {
    local entry=$1
    sudo bootctl set-default "$entry" || return 1
    if grep -q '^default ' /boot/loader/loader.conf 2>/dev/null; then
        sudo sed -i "s|^default .*|default $entry|" /boot/loader/loader.conf || return 1
    else
        echo "default $entry" | sudo tee -a /boot/loader/loader.conf >/dev/null || return 1
    fi
}

show_status() {
    local mode param want
    mode=$(supergfxctl -g 2>/dev/null || echo '?')
    param=$(running_param)

    echo "gfx mode      : $mode"
    echo "boot default  : $(boot_default)"
    echo "running param : $param"
    echo "backlight dev : $(ls /sys/class/backlight/ 2>/dev/null | tr '\n' ' ')"

    case "$mode" in
        AsusMuxDgpu|Hybrid|Integrated)
            want=$(want_param_for "$mode")
            if [ "$param" = "$want" ]; then
                echo "match         : OK (running cmdline suits $mode)"
            else
                echo "match         : MISMATCH - $mode wants '$want', running kernel has '$param'"
                echo "                brightness will not work until you reboot into the right entry"
            fi
            ;;
    esac
}

case "${1:-}" in
    dgpu)       MODE=AsusMuxDgpu; ENTRY=$DGPU_ENTRY ;;
    hybrid)     MODE=Hybrid;      ENTRY=$IGPU_ENTRY ;;
    integrated) MODE=Integrated;  ENTRY=$IGPU_ENTRY ;;
    status)     show_status; exit 0 ;;
    *)          usage ;;
esac

if [ ! -f "/boot/loader/entries/$ENTRY" ]; then
    echo "gfx: missing boot entry /boot/loader/entries/$ENTRY" >&2
    exit 1
fi

CUR_PARAM=$(running_param)
WANT_PARAM=$(want_param_for "$MODE")
PREV_ENTRY=$(boot_default)

echo "gfx: setting boot default -> $ENTRY (efi var + loader.conf)"
set_boot_default "$ENTRY" || { echo "gfx: failed to set boot default, aborting" >&2; exit 1; }

echo "gfx: switching graphics mode -> $MODE"
if ! supergfxctl -m "$MODE"; then
    echo "gfx: mode switch failed; reverting boot default to ${PREV_ENTRY:-$IGPU_ENTRY}" >&2
    set_boot_default "${PREV_ENTRY:-$IGPU_ENTRY}"
    exit 1
fi

echo
if [ "$CUR_PARAM" = "$WANT_PARAM" ]; then
    echo "gfx: done. Backlight cmdline already suits $MODE - no reboot needed for brightness."
    echo "     (supergfxctl may still ask you to log out to finish the GPU switch.)"
else
    echo "gfx: done, but REBOOT REQUIRED for brightness:"
    echo "     running kernel has '$CUR_PARAM', $MODE needs '$WANT_PARAM'."
    echo "     The boot menu now defaults to '$ENTRY'."
fi
